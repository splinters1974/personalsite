---
interface Props { heading: string; intro: string; field: string; demoStep?: boolean }
const { heading, intro, field } = Astro.props;
---
<div class="gate wrap">
  <a class="home" href="/">Martyn Sheridan</a>
  <div class="panel">
    <p class="label">Private</p>
    <h1>{heading}</h1>
    <p class="muted">{intro}</p>
    <form method="post" action="#" class="form" novalidate>
      <label for="pw">{field}</label>
      <input id="pw" name="password" type="password" autocomplete="current-password" required />
      <button class="btn" type="submit">Continue</button>
      <p class="error" role="alert" hidden>That did not work. Check the details and try again.</p>
    </form>
    <slot />
  </div>
  <p class="small muted">Prototype only. In production this check runs on the server, is rate limited and opens a short session for this one item only.</p>
</div>
<style>
  .gate { min-height: 80vh; display: flex; flex-direction: column; padding-block: var(--s-6); }
  .home { font-family: var(--font-display); font-size: var(--step-1); color: var(--ink); text-decoration: none; }
  .panel { margin-block: auto; max-width: 28rem; padding-block: var(--s-8); }
  h1 { font-size: var(--step-3); margin: var(--s-3) 0 var(--s-4); }
  .form { display: grid; gap: var(--s-3); margin-top: var(--s-6); }
  label { font-weight: 560; font-size: var(--step--1); }
  input { padding: 0.75em 0.9em; border: 1px solid var(--rule-strong); border-radius: var(--radius); background: #fff; }
  input:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; border-color: var(--navy); }
  .btn { justify-self: start; margin-top: var(--s-2); }
  .small { font-size: var(--step--1); }
</style>
