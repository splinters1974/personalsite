---
const path = Astro.url.pathname;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/experience/', label: 'Experience' },
  { href: '/projects/', label: 'Projects' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-current={path === '/' ? 'page' : undefined}>Martyn Sheridan</a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); }
  .bar {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--s-5); padding-block: var(--s-5);
  }
  .mark {
    font-family: var(--font-display); font-size: var(--step-1);
    font-weight: 500; color: var(--ink); text-decoration: none; letter-spacing: -0.005em;
  }
  ul { list-style: none; display: flex; gap: clamp(var(--s-4), 2.5vw, var(--s-6)); margin: 0; padding: 0; }
  nav a {
    color: var(--ink-2); text-decoration: none; font-size: var(--step--1);
    font-weight: 520; letter-spacing: 0.02em; padding-block: var(--s-2);
    border-bottom: 1px solid transparent;
  }
  nav a:hover { color: var(--ink); border-bottom-color: var(--rule-strong); }
  nav a[aria-current='page'] { color: var(--navy); border-bottom-color: var(--navy); }

  /* Mobile: name on its own line, nav as a full-width row beneath (no hidden menu) */
  @media (max-width: 34rem) {
    .bar { flex-direction: column; gap: var(--s-2); padding-block: var(--s-4) var(--s-2); }
    ul { width: 100%; justify-content: space-between; }
    nav { width: 100%; }
  }
</style>
