---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home', note: 'The short version' },
  { href: '/about/', label: 'About', note: 'Who I am and how I work' },
  { href: '/experience/', label: 'Track record', note: 'Roles, results and sectors' },
  { href: '/projects/', label: 'Projects', note: 'Tools I build independently' },
  { href: '/contact/', label: 'Contact', note: 'Start a conversation' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label="Martyn Sheridan, home">
      <span class="mono" aria-hidden="true">MS</span>
      <span class="word">Martyn Sheridan</span>
    </a>
    <p class="status"><span class="dot" aria-hidden="true"></span>{site.role}, {site.employer}</p>
    <div class="tools">
      <ThemeToggle />
      <a class="btn cta" href="/contact/">Contact</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <span class="menu-word">Menu</span>
        <span class="burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="menu-grid" aria-hidden="true"></div>
  <div class="wrap menu-top">
    <a class="mark on-dark" href="/" tabindex="-1" aria-hidden="true">
      <span class="mono">MS</span><span class="word">Martyn Sheridan</span>
    </a>
    <button class="menu-btn close" type="button" data-menu-close>
      <span class="menu-word">Close</span>
      <span class="burger open" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
  <div class="wrap menu-body">
    <nav aria-label="Main">
      <ol class="menu-links">
        {links.map((l, i) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{l.label}</span>
              <span class="note">{l.note}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <aside class="menu-side">
      <div>
        <p class="label">Currently</p>
        <p class="side-big">{site.role}<br />{site.employer}</p>
      </div>
      <div>
        <p class="label">Get in touch</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href="/contact/">LinkedIn</a></p>
      </div>
      <div>
        <p class="label">Based in</p>
        <p>{site.location}</p>
      </div>
    </aside>
  </div>
</div>

<script>
  const menu = document.getElementById('site-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const outside = () => document.querySelectorAll<HTMLElement>('main, footer, .site-header, .proto');

  function open() {
    if (!menu || !openBtn) return;
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add('is-open'));
    openBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.classList.add('menu-open');
    outside().forEach((el) => el.setAttribute('inert', ''));
    menu.querySelector<HTMLAnchorElement>('.menu-links a')?.focus();
  }
  function close() {
    if (!menu || !openBtn) return;
    menu.classList.remove('is-open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.documentElement.classList.remove('menu-open');
    outside().forEach((el) => el.removeAttribute('inert'));
    const done = () => { menu.hidden = true; };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
    else setTimeout(done, 260);
    openBtn.focus();
  }
  openBtn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) close();
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
  .bar { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-5); padding-block: var(--s-3); }
  .mark { display: inline-flex; align-items: center; gap: var(--s-3); text-decoration: none; color: var(--ink); }
  .mono { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; background: var(--red); color: var(--red-ink); font: 800 0.95rem/1 var(--font-display); font-stretch: 125%; }
  .word { font: 760 0.95rem/1 var(--font-display); font-stretch: 125%; text-transform: uppercase; letter-spacing: 0.04em; }
  .status { margin: 0; justify-self: center; display: inline-flex; align-items: center; gap: var(--s-2); font: 400 var(--step--2)/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); border: 1px solid var(--rule); padding: 0.55rem 0.8rem; border-radius: 999px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent); }
  .tools { display: flex; gap: var(--s-3); align-items: center; }
  .cta { padding: 0.8em 1.1em; }

  .menu-btn { display: inline-flex; align-items: center; gap: var(--s-3); height: 2.5rem; padding: 0 0.9rem; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); cursor: pointer; border-radius: var(--radius); font: 650 var(--step--1)/1 var(--font-text); letter-spacing: 0.06em; text-transform: uppercase; }
  .menu-btn:hover { background: var(--red); border-color: var(--red); color: var(--red-ink); }
  .burger { display: grid; gap: 5px; width: 18px; }
  .burger i { display: block; height: 2px; background: currentColor; transition: transform var(--dur) var(--ease); }
  .burger.open i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .burger.open i:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  /* Full-screen menu: always dark */
  .menu { position: fixed; inset: 0; z-index: 100; background: var(--band); color: var(--band-ink); overflow-y: auto; opacity: 0; transition: opacity 240ms var(--ease); display: flex; flex-direction: column; }
  .menu.is-open { opacity: 1; }
  .menu-grid { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(rgba(143, 176, 227, 0.06) 1px, transparent 1px) 0 0 / 64px 64px, linear-gradient(90deg, rgba(143, 176, 227, 0.06) 1px, transparent 1px) 0 0 / 64px 64px; }
  .menu-grid::after { content: ''; position: absolute; right: -10vw; bottom: -30vh; width: 60vw; height: 60vw; border-radius: 50%; border: 1px solid rgba(255, 77, 94, 0.25); }
  .menu-top { position: relative; display: flex; justify-content: space-between; align-items: center; padding-block: var(--s-3); border-bottom: 1px solid var(--band-rule); }
  .on-dark { color: var(--band-ink); }
  .on-dark .mono { background: var(--band-red); color: #08111f; }
  .close { background: transparent; color: var(--band-ink); border-color: var(--band-ink); }
  .close:hover { background: var(--band-red); border-color: var(--band-red); color: #08111f; }
  .menu-body { position: relative; flex: 1; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--s-7); align-items: center; padding-block: var(--s-7); }
  .menu-links { list-style: none; margin: 0; padding: 0; }
  .menu-links li { border-bottom: 1px solid var(--band-rule); }
  .menu-links a { display: grid; grid-template-columns: 3rem minmax(0, auto) 1fr; align-items: baseline; gap: var(--s-4); padding-block: clamp(0.5rem, 1.4vh, 1rem); color: var(--band-ink); text-decoration: none; }
  .n { font: 500 var(--step--1)/1 var(--font-mono); color: var(--band-red); }
  .t { font: 800 clamp(2.2rem, 1.2rem + 4.2vw, 5rem)/1 var(--font-display); font-stretch: 125%; letter-spacing: -0.03em; transition: transform 240ms var(--ease), color 240ms var(--ease); }
  .note { font: 400 var(--step--1)/1.3 var(--font-mono); color: var(--band-ink-2); letter-spacing: 0.04em; justify-self: end; opacity: 0; transform: translateX(-8px); transition: opacity 240ms var(--ease), transform 240ms var(--ease); }
  .menu-links a:hover .t, .menu-links a:focus-visible .t { color: var(--band-red); transform: translateX(0.4rem); }
  .menu-links a:hover .note, .menu-links a:focus-visible .note { opacity: 1; transform: none; }
  .menu-links a[aria-current='page'] .t { -webkit-text-stroke: 1.5px var(--band-ink); color: transparent; }
  .menu-side { display: grid; gap: var(--s-6); align-self: end; font-size: var(--step-0); }
  .menu-side .label { color: var(--band-ink-2); margin-bottom: var(--s-2); }
  .menu-side p { margin: 0; }
  .menu-side a { color: var(--band-ink); text-decoration-color: var(--band-red); }
  .side-big { font: 700 var(--step-1)/1.25 var(--font-display); font-stretch: 112%; }

  /* Staggered entrance */
  @media (prefers-reduced-motion: no-preference) {
    .menu-links li { opacity: 0; transform: translateY(14px); transition: opacity 360ms var(--ease), transform 360ms var(--ease); }
    .menu.is-open .menu-links li { opacity: 1; transform: none; }
    .menu.is-open .menu-links li:nth-child(2) { transition-delay: 50ms; }
    .menu.is-open .menu-links li:nth-child(3) { transition-delay: 100ms; }
    .menu.is-open .menu-links li:nth-child(4) { transition-delay: 150ms; }
    .menu.is-open .menu-links li:nth-child(5) { transition-delay: 200ms; }
  }
  @media (prefers-reduced-motion: reduce) { .menu, .t, .note, .burger i { transition: none; } }

  :global(html.menu-open) { overflow: hidden; }

  @media (max-width: 60rem) { .status { display: none; } .bar { grid-template-columns: auto 1fr; } .tools { justify-self: end; } }
  @media (max-width: 52rem) {
    .menu-body { grid-template-columns: 1fr; align-items: start; gap: var(--s-6); }
    .note { display: none; }
    .menu-links a { grid-template-columns: 2.5rem 1fr; }
  }
  @media (max-width: 30rem) {
    .cta { display: none; }
    .word { font-size: 0.78rem; }
    .menu-word { display: none; }
  }
</style>
