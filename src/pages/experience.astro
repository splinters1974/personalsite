---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { experience, qualifications, site } from '../data/site';
import { live } from '../data/text';
---
<Base title="Track record" description="Martyn Sheridan’s track record: Ameresco UK, Centrica, Shawton Energy, Ylem Energy, eEnergy and E.ON, with board and non-executive roles.">
  <div class="wrap exp">
    <header class="head">
      <p class="label kicker">Track record</p>
      <h1>Nearly 30 years in sales. 15 in energy. Four boards.</h1>
      <p class="lede">From blue-chip corporates to private equity-backed growth businesses, the job has been the same: build the pipeline, build the team, close. The full history is on <a href={site.linkedin} rel="noopener">LinkedIn</a>.</p>
    </header>

    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <T text={e.period} as="p" class="period" />
          <div>
            <h2><T text={e.role} /></h2>
            <T text={e.org} as="p" class="org" />
            <T text={e.summary} as="p" class="muted summary" />
            {e.wins.filter(live).length > 0 && <ul class="wins">{e.wins.filter(live).map((w) => <li><T text={w} /></li>)}</ul>}
          </div>
        </li>
      ))}
    </ol>

    <section class="quals" aria-labelledby="q-h">
      <h2 id="q-h" class="label">Education and training</h2>
      <ul>{qualifications.map((q) => <li><T text={q} /></li>)}</ul>
    </section>
  </div>
</Base>
<style>
  .exp { padding-top: var(--s-8); }
  .head { max-width: 50rem; margin-bottom: var(--s-8); }
  .head .label { margin-bottom: var(--s-4); }
  h1 { font-size: var(--step-4); letter-spacing: -0.02em; margin-bottom: var(--s-5); }
  .timeline { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--rule-strong); }
  .timeline > li { display: grid; grid-template-columns: 14rem 1fr; gap: var(--s-5); padding-block: var(--s-6); border-bottom: 1px solid var(--rule); }
  .period { color: var(--ink-3); font-size: var(--step--1); font-variant-numeric: tabular-nums; padding-top: 0.4rem; }
  .timeline h2 { font-size: var(--step-2); }
  .org { font-weight: 560; margin: var(--s-1) 0 var(--s-3); }
  .summary { max-width: var(--measure); }
  .wins { list-style: none; padding: 0; margin: var(--s-4) 0 0; display: grid; gap: var(--s-2); font-size: var(--step--1); }
  .wins li { display: grid; grid-template-columns: 0.9rem 1fr; gap: var(--s-2); }
  .wins li::before { content: ''; width: 0.6rem; height: 2px; background: var(--red); margin-top: 0.7em; }
  .timeline h2 { font-size: var(--step-2); }
  .quals { display: grid; grid-template-columns: 14rem 1fr; gap: var(--s-5); padding-top: var(--s-7); }
  .quals ul { margin: 0; padding-left: 1.1em; }
  @media (max-width: 40rem) {
    .timeline > li, .quals { grid-template-columns: 1fr; gap: var(--s-2); }
  }
</style>
