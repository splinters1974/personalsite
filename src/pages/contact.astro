---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { site } from '../data/site';
---
<Base title="Contact" description="Contact Martyn Sheridan by email or LinkedIn.">
  <div class="wrap contact">
    <p class="label">Contact</p>
    <h1>The best way to reach me is email.</h1>
    <dl>
      <div><dt class="label">Email</dt><dd><a class="big" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      <div><dt class="label">LinkedIn</dt><dd><T text={site.linkedin} class="big-ish" /></dd></div>
      <div><dt class="label">Based in</dt><dd class="big-ish">{site.location}</dd></div>
    </dl>
    <p class="muted note">
      For anything about Ameresco UK projects, please contact me through Ameresco directly.
      If you have been invited to test a project, use the link you were sent.
    </p>
  </div>
</Base>
<style>
  .contact { padding-top: var(--s-8); max-width: 60rem; }
  h1 { font-size: var(--step-4); font-weight: 380; letter-spacing: -0.02em; margin: var(--s-4) 0 var(--s-7); }
  dl { margin: 0; border-top: 1px solid var(--ink); }
  dl > div { display: grid; grid-template-columns: 10rem 1fr; gap: var(--s-4); padding-block: var(--s-5); border-bottom: 1px solid var(--rule); align-items: baseline; }
  dd { margin: 0; }
  .big { font-family: var(--font-display); font-size: var(--step-3); overflow-wrap: anywhere; }
  .big-ish { font-family: var(--font-display); font-size: var(--step-2); }
  .note { margin-top: var(--s-6); max-width: var(--measure); font-size: var(--step--1); }
  @media (max-width: 40rem) { .big { font-size: var(--step-2); } dl > div { grid-template-columns: 1fr; gap: var(--s-1); } }
</style>
