---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { about } from '../data/site';
---
<Base title="About" description="About Martyn Sheridan, from advertising sales to commercial leadership in energy, with an interest in rugby, film and building digital tools.">
  <article class="wrap about">
    <header class="head">
      <p class="label kicker">About</p>
      <h1>{about.headline}</h1>
    </header>
    <figure class="portrait">
      <img src="https://d2ol7oe51mr4n9.cloudfront.net/user_3JHfNLjekklv2IsLBvSXs5fkIg3/ee9f88a6-a650-4115-a215-4155c2afb7d1.jpg" alt="Martyn Sheridan, informal portrait" loading="eager" width="1086" height="1448" />
      <figcaption class="label">Hampshire, UK</figcaption>
    </figure>}
    <div class="body">
      {about.paragraphs.map((p, i) => <T text={p} as="p" class={i === 0 ? 'lede' : ''} />)}
      <h2 class="label sub">Outside work</h2>
      <ul class="interests">
        {about.interests.map((x) => <li><T text={x} /></li>)}
      </ul>
      <p class="aside muted">
        The websites and tools here are my own projects, not part of my job at Ameresco UK.
        See <a href="/projects/">projects</a>, or my <a href="/experience/">track record</a> for the career side.
      </p>
    </div>
  </article>
</Base>
<style>
  .about { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--s-5); padding-top: var(--s-8); }
  .head { grid-column: 1 / 10; margin-bottom: var(--s-7); }
  .head .label { margin-bottom: var(--s-4); }
  h1 { font-size: var(--step-4); letter-spacing: -0.02em; }
  .portrait { grid-column: 1 / 4; margin: 0; position: sticky; top: var(--s-5); align-self: start; }
  .portrait img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .portrait figcaption { margin-top: var(--s-2); }
  .body { grid-column: 5 / 12; max-width: var(--measure); }
  .sub { margin-top: var(--s-7); margin-bottom: var(--s-3); }
  .interests { list-style: none; padding: 0; margin: 0 0 var(--s-6); border-top: 1px solid var(--rule); }
  .interests li { padding-block: var(--s-3); border-bottom: 1px solid var(--rule); font-weight: 560; font-size: var(--step-0); }
  .aside { font-size: var(--step--1); }
  @media (max-width: 48rem) {
    .head, .body { grid-column: 1 / -1; }
    .portrait { grid-column: 1 / 6; position: static; margin-bottom: var(--s-6); }
  }
</style>
