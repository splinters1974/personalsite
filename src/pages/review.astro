---
/* Prototype-only page: renders the Phase 1 discovery doc. Remove before launch. */
import Base from '../layouts/Base.astro';
import { Content } from '../../docs/PHASE1-DISCOVERY.md';
---
<Base title="Review notes" noindex>
  <article class="wrap doc"><Content /></article>
</Base>
<style>
  .doc { padding-top: var(--s-7); max-width: 52rem; }
  .doc :global(h1) { font-size: var(--step-4); margin-bottom: var(--s-4); }
  .doc :global(h2) { font-size: var(--step-3); margin: var(--s-7) 0 var(--s-4); padding-top: var(--s-4); border-top: 1px solid var(--rule); }
  .doc :global(li) { margin-bottom: var(--s-2); }
  .doc :global(table) { width: 100%; border-collapse: collapse; font-size: var(--step--1); display: block; overflow-x: auto; }
  .doc :global(th), .doc :global(td) { text-align: left; vertical-align: top; padding: var(--s-2) var(--s-3) var(--s-2) 0; border-bottom: 1px solid var(--rule); }
  .doc :global(th) { border-bottom-color: var(--ink); }
  .doc :global(pre) { background: var(--paper-2) !important; color: var(--ink) !important; padding: var(--s-4); overflow-x: auto; font-size: 0.8rem; line-height: 1.35; border: 1px solid var(--rule); }
  .doc :global(code) { font-size: 0.9em; }
</style>
