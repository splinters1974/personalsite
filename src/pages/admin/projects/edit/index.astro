---
import Admin from '../../../../layouts/Admin.astro';
const states = [
  { v: 'draft', t: 'Draft', d: 'Only you can see it, here in admin.' },
  { v: 'public', t: 'Public', d: 'Listed on the projects page and in search results.' },
  { v: 'unlisted', t: 'Unlisted', d: 'Not listed anywhere, but anyone with the URL can open it. This is not secure.' },
  { v: 'private', t: 'Private', d: 'Needs this project’s password or an invitation link. Opens nothing else.' },
  { v: 'archived', t: 'Archived', d: 'Kept here, removed from the public site.' },
];
---
<Admin title="Edit project" section="projects">
  <div class="a-head">
    <div><p class="label"><a href="/admin/">Overview</a> / Projects</p><h1>Hospital Energy Insights</h1></div>
    <div class="actions">
      <a class="btn btn--ghost" href="#">Preview</a>
      <button class="btn" type="button">Save changes</button>
    </div>
  </div>

  <nav class="jump" aria-label="Sections of this project">
    <a href="#details">Details</a><a href="#visibility">Visibility</a><a href="#link">Link and hosting</a><a href="#files">Files</a><a href="#sharing">Sharing</a>
  </nav>

  <form class="editor" action="#" method="post">
    <section class="panel" id="details">
      <h2>Details</h2>
      <div class="grid2">
        <div class="field"><label for="name">Name</label><input id="name" value="Hospital Energy Insights" /></div>
        <div class="field"><label for="type">Type</label>
          <select id="type"><option>Website</option><option>Calculator</option><option>Web app</option><option>Document</option><option selected>Prototype</option></select></div>
      </div>
      <div class="field"><label for="summary">Short description</label><textarea id="summary" rows="2">Placeholder description.</textarea><span class="hint">Shown in listings. One or two sentences.</span></div>
      <div class="grid2">
        <div class="field"><label for="status">Status</label><input id="status" value="In testing" /></div>
        <div class="field"><label for="aud">Intended audience</label><input id="aud" value="Invited testers" /></div>
      </div>
      <div class="field"><label for="layout">Page layout</label>
        <select id="layout"><option selected>Feature: large screenshot, facts beside text</option><option>Notes: narrow, long-form</option></select>
        <span class="hint">Lets project pages look different from each other.</span></div>
    </section>

    <section class="panel" id="visibility">
      <h2>Visibility</h2>
      <fieldset class="states">
        <legend class="visually-hidden">Who can see this project</legend>
        {states.map((s) => (
          <label class="state">
            <input type="radio" name="vis" value={s.v} checked={s.v === 'private'} />
            <span><strong>{s.t}</strong><span class="hint">{s.d}</span></span>
          </label>
        ))}
      </fieldset>
      <label class="check"><input type="checkbox" /> Feature on the homepage (public projects only)</label>
    </section>

    <section class="panel" id="link">
      <h2>Link and hosting</h2>
      <div class="field"><label for="url">Live project URL</label><input id="url" value="https://example-prototype.netlify.app" /></div>
      <div class="field"><label for="prot">How is the project itself protected?</label>
        <select id="prot">
          <option>Not protected: public site</option>
          <option selected>Portal-controlled discovery only</option>
          <option>End-to-end protected: the host checks access</option>
        </select>
      </div>
      <p class="warn-box"><strong>Portal-controlled discovery only.</strong> This site hides the link, but the project’s own host does not check access. Anyone who has the URL can still open it. Only choose “end-to-end protected” once the host itself enforces sign-in.</p>
    </section>

    <section class="panel" id="files">
      <h2>Files</h2>
      <div class="drop">
        <p><strong>Drop files here</strong> or <button type="button" class="linkish">choose files</button></p>
        <p class="hint">PDF, images, spreadsheets and presentations. Up to 50 MB each. Files upload straight to private storage and are only served through short-lived links.</p>
      </div>
      <div class="tbl-scroll"><table class="tbl">
        <thead><tr><th>File</th><th>Size</th><th>Added</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <tr><td>tester-guide-v2.pdf</td><td>1.8 MB</td><td>12 Nov</td><td class="row-actions"><a href="#">Download</a> <a href="#">Replace</a> <a href="#" class="danger">Delete</a></td></tr>
          <tr><td>dashboard-screenshot.png</td><td>640 KB</td><td>10 Nov</td><td class="row-actions"><a href="#">Download</a> <a href="#">Replace</a> <a href="#" class="danger">Delete</a></td></tr>
        </tbody>
      </table></div>
    </section>

    <section class="panel" id="sharing">
      <h2>Sharing</h2>
      <div class="share-grid">
        <div>
          <h3 class="h3">Project password</h3>
          <p class="hint">One shared password for this project only. It does not tell you who opened it.</p>
          <p class="pw-state"><span class="tag private">Set</span> Changed 3 days ago</p>
          <div class="btn-row"><button type="button" class="btn btn--ghost">Change password</button><button type="button" class="btn btn--danger">Turn off</button></div>
          <p class="hint">Changing or turning off the password ends every session opened with it.</p>
        </div>
        <div>
          <h3 class="h3">New invitation link</h3>
          <div class="field"><label for="rname">Recipient name (optional)</label><input id="rname" /></div>
          <div class="field"><label for="remail">Lock to email (optional)</label><input id="remail" type="email" /><span class="hint">They will be asked to confirm a code sent to this address.</span></div>
          <div class="grid2">
            <div class="field"><label for="exp">Expires</label><select id="exp"><option>7 days</option><option>14 days</option><option>30 days</option><option>Never</option></select></div>
            <div class="field"><label for="uses">Uses</label><select id="uses"><option>Unlimited</option><option>One time</option><option>5 times</option></select></div>
          </div>
          <button type="button" class="btn">Create link</button>
          <p class="warn-box small">A link without an email lock works for anyone it is forwarded to.</p>
        </div>
      </div>
      <h3 class="h3 spaced">Active invitations</h3>
      <div class="tbl-scroll">
        <table class="tbl">
          <thead><tr><th>Recipient</th><th>Locked to</th><th>Expires</th><th>Used</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody>
            <tr><td>Tester A</td><td class="hint">Anyone with link</td><td>in 6 days</td><td>2 of unlimited</td><td class="row-actions"><a href="#">Copy link</a> <a href="#" class="danger">Revoke</a></td></tr>
            <tr><td>Tester B</td><td class="hint">b•••@nhs.net</td><td>in 13 days</td><td>0 of 1</td><td class="row-actions"><a href="#">Copy link</a> <a href="#" class="danger">Revoke</a></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel danger-zone">
      <h2>Archive or delete</h2>
      <div class="btn-row"><button type="button" class="btn btn--ghost">Archive project</button><button type="button" class="btn btn--danger">Delete project…</button></div>
      <p class="hint">Delete asks you to type the project name. Deleted items can be restored from backup for 7 days.</p>
    </section>
  </form>
</Admin>
<style>
  .actions, .btn-row { display: flex; gap: var(--s-3); flex-wrap: wrap; }
  .jump { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); margin-bottom: var(--s-5); font-size: 0.92rem; position: sticky; top: 0; background: #fff; padding-block: var(--s-3); border-bottom: 1px solid var(--rule); z-index: 1; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
  .states { border: 0; margin: 0 0 var(--s-4); padding: 0; display: grid; gap: var(--s-2); }
  .state { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; padding: var(--s-3); border: 1px solid var(--rule); border-radius: var(--radius); cursor: pointer; }
  .state:has(input:checked) { border-color: var(--navy); background: var(--navy-tint); }
  .state input { margin-top: 0.3rem; accent-color: var(--navy); }
  .state strong { display: block; font-weight: 600; }
  .check { display: flex; gap: var(--s-2); align-items: center; font-size: 0.92rem; }
  .drop { border: 1px dashed var(--rule-strong); border-radius: var(--radius); padding: var(--s-5); text-align: center; margin-bottom: var(--s-4); background: var(--paper); }
  .linkish { background: none; border: 0; padding: 0; color: var(--navy); text-decoration: underline; cursor: pointer; font: inherit; }
  .row-actions { white-space: nowrap; }
  .row-actions a { margin-right: var(--s-3); }
  .danger { color: var(--danger); }
  .share-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: var(--s-6); }
  .h3 { font: 600 0.95rem/1.3 var(--font-text); margin-bottom: var(--s-2); }
  .spaced { margin-top: var(--s-6); }
  .pw-state { display: flex; gap: var(--s-3); align-items: center; font-size: 0.92rem; margin: var(--s-3) 0; }
  .small { margin-top: var(--s-4); font-size: var(--step--1); }
  @media (max-width: 52rem) { .grid2, .share-grid { grid-template-columns: 1fr; } }
</style>
