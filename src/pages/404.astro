---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap nf">
    <p class="label">404</p>
    <h1>That page is not here.</h1>
    <p class="muted">It may have moved, or the link may be wrong. Try the <a href="/">homepage</a> or <a href="/projects/">projects</a>.</p>
  </div>
</Base>
<style>.nf { padding-block: var(--s-9); } h1 { font-size: var(--step-4); margin: var(--s-3) 0 var(--s-4); }</style>
